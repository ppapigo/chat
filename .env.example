# Copy to .env and replace all placeholders. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chat
DB_USERNAME=chat
DB_PASSWORD=replace-with-your-database-password
REDIS_HOST=localhost
REDIS_PORT=6379
# Base64-encoded HMAC key, at least 32 decoded bytes. Must match Board.
JWT_SECRET=replace-with-the-board-base64-jwt-secret
# Board users must be accessible on the same MySQL server.
APP_BOARD_SCHEMA=board
# Comma-separated browser origins. Set exact HTTPS origins in production.
APP_WS_ALLOWED_ORIGINS=http://localhost:8092,http://127.0.0.1:8092
